# Required API Keys
ANTHROPIC_API_KEY="your-anthropic-api-key" # Needed if proxying *to* Anthropic
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="your-google-ai-studio-key"

# OpenRouter configuration
OPENROUTER_API_KEY="sk-or-..." # OpenRouter API key
OPENROUTER_API_BASE="https://openrouter.ai/api/v1" # OpenRouter endpoint

# Optional: Provider Preference and Model Mapping
# Controls which provider (google, openai, or openrouter) is preferred for mapping haiku/sonnet.
# Defaults to openai if not set.
PREFERRED_PROVIDER="openai" # Options: openai, google, openrouter

# Optional: Specify the exact models to map haiku/sonnet to.
# If PREFERRED_PROVIDER=google, these MUST be valid Gemini model names known to the server.
# If PREFERRED_PROVIDER=openrouter, these MUST be valid OpenRouter model names (without prefix).
# Defaults to gemini-2.5-pro-preview-03-25 and gemini-2.0-flash if PREFERRED_PROVIDER=google.
# Defaults to gpt-4.1 and gpt-4.1-mini if PREFERRED_PROVIDER=openai.
# Defaults to anthropic/claude-3-opus and anthropic/claude-3-haiku if PREFERRED_PROVIDER=openrouter.
# BIG_MODEL="gpt-4.1"
# SMALL_MODEL="gpt-4.1-mini"

# Example Google mapping:
# PREFERRED_PROVIDER="google"
# BIG_MODEL="gemini-2.5-pro-preview-03-25"
# SMALL_MODEL="gemini-2.0-flash"

# Example OpenRouter mapping:
# PREFERRED_PROVIDER="openrouter"
# BIG_MODEL="openrouter/anthropic/claude-3-opus"
# SMALL_MODEL="openrouter/anthropic/claude-3-haiku"

# Optional: Custom API endpoints
OPENAI_API_BASE="https://your-custom-endpoint.com/v1"
# ANTHROPIC_API_BASE="https://your-custom-anthropic-endpoint.com"
# GEMINI_API_BASE="https://your-custom-gemini-endpoint.com"